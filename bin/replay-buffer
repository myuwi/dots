#!/usr/bin/env bash

# When gsr saves a replay, it runs this script with the video path as $1.
if [ -n "$1" ]; then
  notify-send "Replay saved" "$1"
  exit 0
fi

self="$(realpath "$0")"
exec gpu-screen-recorder -w DP-2 -a default_output -a game_sink.monitor -a rnnoise_source \
  -f 60 -r 90 -fm vfr -tune performance -replay-storage ram -k hevc_vulkan -bm cbr -q 35000 -c mp4 -sc "$self" -o ~/Videos
