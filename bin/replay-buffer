#!/usr/bin/env bash

sock="${XDG_RUNTIME_DIR:-/tmp}/gsr.sock"

case "${1:-start}" in
save)
  if ! out="$(gsr-cli -ipc "$sock" save-replay 2>&1)"; then
    notify-send -u critical -a "Replay buffer" "Save failed" "$out"
    exit 1
  fi
  notify-send -a "Replay buffer" "Replay saved" "$out"
  exit 0
  ;;
start) ;;
*)
  echo "usage: ${0##*/} [start|save]" >&2
  exit 1
  ;;
esac

exec gpu-screen-recorder \
  -w DP-2 \
  -a 'name:Desktop|default_output' \
  -a 'name:Game|game_sink.monitor' \
  -a 'name:Microphone|rnnoise_source' \
  -f 60 -r 90 -fm vfr -tune performance -replay-storage ram \
  -k hevc_vulkan -bm cbr -q 35000 -c mp4 -ipc "$sock" -o ~/Videos
