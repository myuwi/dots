#!/usr/bin/env nu

# Manage dotfile symlinks declaratively
def main [] { help main }

# Resolve the manifest into a link plan
def "main resolve" []: nothing -> table<pattern: string, source: string, target: string> {
  build-plan
}

# Compare the resolved link plan against what's on disk
def "main status" []: nothing -> table<state: string, target: string, source: string> {
  survey | shorten-paths | sort-by state target
}

# Apply the resolved link plan
def "main apply" [--dry-run]: nothing -> table<action: string, target: string, source: string> {
  let actions = survey | where state != "ok"
  if not $dry_run {
    $actions | each {|a| run-action $a } | ignore
  }
  $actions | shorten-paths | update state {|a| $a.state | as-action } | rename --column {state: action}
}

# The state of every path the manifest covers, stale links first
def survey []: nothing -> table<state: string, target: string, source: string> {
  let plan = (build-plan)
  let claimed = $plan | get target

  # Stale links go first: one may be a directory the plan now links inside
  let stale = managed-links | where {|l| $l.link not-in $claimed }
  let doomed = $stale | get link

  $stale
  | each {|l| {state: "stale", target: $l.link, source: $l.points-to} }
  | append (
    $plan
    | each {|r| {state: (link-state $r.target $r.source $doomed), target: $r.target, source: $r.source} }
  )
}

# What apply does about a target in each state
def as-action []: string -> string {
  match $in {
    missing => "create"
    wrong => "relink"
    stale => "remove"
    conflict => "conflict"
  }
}

def run-action [action: record] {
  match $action.state {
    "missing" => { create-link $action.target $action.source }
    "wrong" => {
      rm $action.target
      create-link $action.target $action.source
    }
    "stale" => { rm $action.target }
    "conflict" => { }
  }
}

# Point target at source, creating any missing parent directories
def create-link [target: string, source: string] {
  mkdir ($target | path dirname)
  ^ln -s $source $target
}

# Resolve the manifest into a concrete source -> target plan
def build-plan []: nothing -> table<pattern: string, source: string, target: string> {
  let manifest = (load-manifest)

  let excluded = (
    $manifest
    | where not enabled
    | each {|e| $e.pattern | expand | get target }
    | flatten
  )

  let matched = (
    $manifest | where enabled | each {|e|
      let hits = $e.pattern | expand
      if ($hits | is-empty) { error make {msg: $"pattern matches nothing: ($e.pattern)"} }
      $hits
    } | flatten
    | where {|r| not ($excluded | any {|x| $r.target | is-at-or-under $x }) }
  )
  let candidates = $matched | uniq-by target

  # A directory is never linked whole when another entry claims something inside it
  let dropped = (
    $candidates | where {|r| $candidates | any {|o| $o.target | is-under $r.target } } | get target
  )

  # Any pattern claiming a dropped target counts, not just the one uniq-by kept
  let exact = (
    $matched
    | where {|r| $r.target in $dropped and not ($r.pattern | str contains "*") }
  )
  if ($exact | is-not-empty) {
    let bad = $exact | first
    let claimant = $candidates | where {|o| $o.target | is-under $bad.target } | get pattern.0
    error make {msg: $"($bad.pattern) cannot be linked as a directory: ($claimant) claims a path inside it; use ($bad.pattern)/* instead"}
  }

  $candidates | where {|r| $r.target not-in $dropped } | sort-by target
}

def load-manifest []: nothing -> table<pattern: string, enabled: bool> {
  let file = repo-root | path join "dots.toml"
  if not ($file | path exists) {
    error make {msg: $"manifest not found: ($file)"}
  }
  let entries = open $file | get -o dotfiles
  if ($entries | is-empty) {
    error make {msg: $"($file): missing or empty [dotfiles] table"}
  }
  let rows = $entries | transpose pattern enabled
  let bad = $rows | where {|r| ($r.enabled | describe) != "bool" }
  if ($bad | is-not-empty) {
    let names = $bad | get pattern | str join ", "
    error make {msg: $"($file): values must be true or false, got: ($names)"}
  }
  $rows
}

# Every source path a pattern matches, with the target it maps to
def expand []: string -> table<pattern: string, source: string, target: string> {
  let pattern = $in
  let root = (source-root)
  glob ($root | path join $pattern) | each {|src|
    {
      pattern: $pattern
      source: $src
      target: ($nu.home-dir | path join ($src | path relative-to $root))
    }
  }
}

# How a target compares to the source it should point at, counting doomed links as gone
def link-state [target: string, source: string, doomed: list<string> = []]: nothing -> string {
  let kind = (
    if ($doomed | any {|d| $target | is-under $d }) { "" } else {
      $target | path type | default ""
    }
  )
  if $kind == "" {
    "missing"
  } else if $kind != "symlink" {
    "conflict"
  } else if ($target | link-target) != $source {
    "wrong"
  } else {
    "ok"
  }
}

# Where a symlink points, resolved to an absolute path without following it
def link-target []: string -> string {
  let link = $in
  let parent = $link | path dirname
  let raw = ls --long -a $parent | where name == $link | get target.0
  $parent | path join $raw | path expand --no-symlink
}

# Every symlink under $HOME that points into the repo's home/ tree
def managed-links []: nothing -> table<link: string, points-to: string> {
  let root = (source-root)
  ^find $nu.home-dir -type l -printf "%p\t%l\n"
  | lines
  | parse "{link}\t{raw}"
  | insert points-to {|l| $l.link | path dirname | path join $l.raw | path expand --no-symlink }
  | where {|l| $l.points-to | is-at-or-under $root }
  | select link points-to
}

def shorten-paths []: table -> table {
  update target {|r| $r.target | shorten } | update source {|r| $r.source | shorten }
}

# Paths read more clearly relative to $HOME
def shorten []: string -> string {
  let p = $in
  if ($p | str starts-with $"($nu.home-dir)/") {
    $"~/($p | path relative-to $nu.home-dir)"
  } else {
    $p
  }
}

def is-under [parent: string]: string -> bool {
  $in != $parent and ($in | str starts-with $"($parent)/")
}

def is-at-or-under [parent: string]: string -> bool {
  $in == $parent or ($in | is-under $parent)
}

def source-root []: nothing -> string {
  repo-root | path join "home"
}

def repo-root []: nothing -> string {
  $env.CURRENT_FILE | path dirname | path dirname
}
