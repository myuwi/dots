#!/usr/bin/env bash

case $1 in
home)
  xrandr --output DP-2 --primary --mode 2560x1440 --rate 360.00 --pos 0x0 \
    --output HDMI-0 --mode 1920x1080 --rate 60.00 --pos -1920x400 \
    --output DP-4 --mode 1920x1080 --rate 144.00 --pos 2560x400
  ;;
mirror)
  xrandr --listmonitors |
    sed -n '1!p' |
    sed -e 's/\s[0-9].*\s\([a-zA-Z0-9\-]*\)$/\1/g' |
    xargs -I{} -- bash -xc 'xrandr --output {} --mode "1920x1080" --pos 0x0 --rotate normal'
  ;;
*)
  echo "Unknown configuration \"$1\"."
  ;;
esac
