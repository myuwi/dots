#!/usr/bin/env nu

# Manage dotfile symlinks declaratively
def main [] { help main }

# Print the resolved link plan
def "main resolve" []: nothing -> table<pattern: string, source: string, target: string> {
  build-plan
}

# Compare the resolved plan against what is on disk
def "main status" []: nothing -> table<state: string, target: string, source: string> {
  let plan = (build-plan)

  let checked = ($plan | each {|r|
    {
      state: (link-state $r.target $r.source)
      target: ($r.target | shorten)
      source: ($r.source | shorten)
    }
  })

  let claimed = ($plan | get target)
  let stale = (
    managed-links
    | where {|l| $l.link not-in $claimed }
    | each {|l| {state: "stale", target: ($l.link | shorten), source: ($l.points-to | shorten)} }
  )

  $checked | append $stale | sort-by state target
}

# Create the links the plan calls for
def "main link" [--dry-run]: nothing -> table<action: string, target: string, source: string> {
  build-plan | each {|r|
    let action = (match (link-state $r.target $r.source) {
      "ok" => "ok"
      "missing" => (if $dry_run { "would create" } else { create-link $r.target $r.source; "created" })
      "wrong" => (if $dry_run { "would relink" } else { rm $r.target; create-link $r.target $r.source; "relinked" })
      "conflict" => "conflict"
    })
    {action: $action, target: ($r.target | shorten), source: ($r.source | shorten)}
  }
  | where action != "ok"
}

# Point target at source, creating any missing parent directories
def create-link [target: string, source: string] {
  mkdir ($target | path dirname)
  ^ln -s $source $target
}

# Remove links into home/ that the plan no longer claims
def "main prune" [--dry-run]: nothing -> table<action: string, target: string, points-to: string> {
  let claimed = (build-plan | get target)

  managed-links
  | where {|l| $l.link not-in $claimed }
  | each {|l|
      if not $dry_run { rm $l.link }
      {
        action: (if $dry_run { "would remove" } else { "removed" })
        target: ($l.link | shorten)
        points-to: ($l.points-to | shorten)
      }
    }
}

# Resolve the manifest into a concrete source -> target plan
def build-plan []: nothing -> table<pattern: string, source: string, target: string> {
  let manifest = (load-manifest)

  let excluded = (
    $manifest | where enabled == false
    | each {|e| $e.pattern | expand | get target }
    | flatten
  )

  let candidates = (
    $manifest | where enabled == true
    | each {|e|
        let rows = ($e.pattern | expand)
        if ($rows | is-empty) {
          error make {msg: $"pattern matches nothing: ($e.pattern)"}
        }
        $rows
      }
    | flatten
    | where {|r| not ($excluded | any {|x| $r.target | is-at-or-under $x }) }
  )

  # Most specific pattern wins when two produce the same target
  let deduped = (
    $candidates | group-by target | transpose target rows | each {|g|
      let ranked = ($g.rows | sort-by {|r| $r.pattern | specificity } --reverse)
      if ($ranked | length) > 1 and (($ranked.0.pattern | specificity) == ($ranked.1.pattern | specificity)) {
        let pats = ($ranked | get pattern | str join ", ")
        error make {msg: $"ambiguous: ($g.target) claimed equally by: ($pats)"}
      }
      $ranked.0
    }
  )

  # A directory is never linked whole when another entry claims something inside it
  let suppressed = (
    $deduped | where {|r| $deduped | any {|o| $o.target | is-under $r.target } }
  )

  # Subtracting from a glob is intended; suppressing an exact entry contradicts it
  let exact = ($suppressed | where {|r| not ($r.pattern | str contains "*") })
  if ($exact | is-not-empty) {
    let bad = ($exact | first)
    let claimant = ($deduped | where {|o| $o.target | is-under $bad.target } | get pattern.0)
    error make {msg: $"($bad.pattern) cannot be linked as a directory: ($claimant) claims a path inside it; use ($bad.pattern)/* instead"}
  }

  let dropped = ($suppressed | get target)
  $deduped | where {|r| $r.target not-in $dropped } | sort-by target
}

def load-manifest []: nothing -> table<pattern: string, enabled: bool> {
  let file = (repo-root | path join "dots.toml")
  if not ($file | path exists) {
    error make {msg: $"manifest not found: ($file)"}
  }
  let entries = (open $file | get -o dotfiles)
  if ($entries | is-empty) {
    error make {msg: $"($file): missing or empty [dotfiles] table"}
  }
  let rows = ($entries | transpose pattern enabled)
  let bad = ($rows | where {|r| ($r.enabled | describe) != "bool" })
  if ($bad | is-not-empty) {
    let names = ($bad | get pattern | str join ", ")
    error make {msg: $"($file): values must be true or false, got: ($names)"}
  }
  $rows
}

# Every source path a pattern matches, with the target it maps to
def expand []: string -> table<pattern: string, source: string, target: string> {
  let pattern = $in
  let root = (source-root)
  glob ($root | path join $pattern) | each {|src|
    {
      pattern: $pattern
      source: $src
      target: ($nu.home-dir | path join ($src | path relative-to $root))
    }
  }
}

# Literal path segments before the first glob; exact patterns rank highest
def specificity []: string -> int {
  let pattern = $in
  if not ($pattern | str contains "*") {
    999
  } else {
    $pattern | split row "/" | enumerate | where {|s| $s.item | str contains "*"} | get 0.index
  }
}

# How a target compares to the source it should point at
def link-state [target: string, source: string]: nothing -> string {
  let kind = ($target | path type | default "")
  if $kind == "" {
    "missing"
  } else if $kind != "symlink" {
    "conflict"
  } else if ($target | link-target) != $source {
    "wrong"
  } else {
    "ok"
  }
}

# Where a symlink points, resolved to an absolute path without following it
def link-target []: string -> string {
  let link = $in
  let parent = ($link | path dirname)
  let raw = (ls --long -a $parent | where name == $link | get target.0)
  $parent | path join $raw | path expand --no-symlink
}

# Every symlink under $HOME that points into the repo's home/ tree
def managed-links []: nothing -> table<link: string, points-to: string> {
  let root = (source-root)
  glob $"($nu.home-dir)/**/*" --depth 4 --exclude ["**/.cache/**" "**/.local/state/**"]
  | where {|p| ($p | path type) == "symlink" }
  | each {|p| {link: $p, points-to: ($p | link-target)} }
  | where {|l| $l.points-to | is-at-or-under $root }
}

# Paths read more clearly relative to $HOME
def shorten []: string -> string {
  let p = $in
  if ($p | str starts-with $"($nu.home-dir)/") {
    $"~/($p | path relative-to $nu.home-dir)"
  } else {
    $p
  }
}

def is-under [parent: string]: string -> bool {
  $in != $parent and ($in | str starts-with $"($parent)/")
}

def is-at-or-under [parent: string]: string -> bool {
  $in == $parent or ($in | is-under $parent)
}

def source-root []: nothing -> string {
  repo-root | path join "home"
}

def repo-root []: nothing -> string {
  $env.CURRENT_FILE | path dirname | path dirname
}
