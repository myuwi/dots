#!/usr/bin/env nu

# Manage dotfile symlinks declaratively
def main [] { help main }

# Print the resolved link plan
def "main resolve" []: nothing -> table<pattern: string, source: string, target: string> {
  build-plan
}

# Resolve the manifest into a concrete source -> target plan
def build-plan []: nothing -> table<pattern: string, source: string, target: string> {
  let manifest = (load-manifest)

  let excluded = (
    $manifest | where enabled == false
    | each {|e| $e.pattern | expand | get target }
    | flatten
  )

  let candidates = (
    $manifest | where enabled == true
    | each {|e|
        let rows = ($e.pattern | expand)
        if ($rows | is-empty) {
          error make {msg: $"pattern matches nothing: ($e.pattern)"}
        }
        $rows
      }
    | flatten
    | where {|r| not ($r.target in $excluded) }
    | where {|r| not ($excluded | any {|x| $r.target | is-under $x }) }
  )

  # Most specific pattern wins when two produce the same target
  let deduped = (
    $candidates | group-by target | transpose target rows | each {|g|
      let ranked = ($g.rows | insert rank {|r| $r.pattern | specificity } | sort-by rank --reverse)
      let top = ($ranked | where rank == $ranked.0.rank)
      if ($top | length) > 1 {
        let pats = ($top | get pattern | str join ", ")
        error make {msg: $"ambiguous: ($g.target) claimed equally by: ($pats)"}
      }
      $ranked.0 | reject rank
    }
  )

  # A directory is never linked whole when another entry claims something inside it
  let suppressed = (
    $deduped | where {|r| $deduped | any {|o| $o.target | is-under $r.target } }
  )

  # Subtracting from a glob is intended; suppressing an exact entry contradicts it
  let exact = ($suppressed | where {|r| not ($r.pattern | str contains "*") })
  if ($exact | is-not-empty) {
    let bad = ($exact | first)
    let claimant = ($deduped | where {|o| $o.target | is-under $bad.target } | get pattern.0)
    error make {msg: $"($bad.pattern) cannot be linked as a directory: ($claimant) claims a path inside it; use ($bad.pattern)/* instead"}
  }

  let dropped = ($suppressed | get target)
  $deduped | where {|r| $r.target not-in $dropped } | sort-by target
}

def load-manifest []: nothing -> table<pattern: string, enabled: bool> {
  let file = (repo-root | path join "dots.toml")
  if not ($file | path exists) {
    error make {msg: $"manifest not found: ($file)"}
  }
  let entries = (open $file | get -o dotfiles)
  if ($entries | is-empty) {
    error make {msg: $"($file): missing or empty [dotfiles] table"}
  }
  let bad = ($entries | transpose pattern value | where {|r| ($r.value | describe) != "bool"})
  if ($bad | is-not-empty) {
    let names = ($bad | get pattern | str join ", ")
    error make {msg: $"($file): values must be true or false, got: ($names)"}
  }
  $entries | transpose pattern enabled
}

# Every source path a pattern matches, with the target it maps to
def expand []: string -> table<pattern: string, source: string, target: string> {
  let pattern = $in
  let root = (source-root)
  glob ($root | path join $pattern) | each {|src|
    {
      pattern: $pattern
      source: $src
      target: ($nu.home-dir | path join ($src | path relative-to $root))
    }
  }
}

# Literal path segments before the first glob; exact patterns rank highest
def specificity []: string -> int {
  let pattern = $in
  if not ($pattern | str contains "*") {
    999
  } else {
    $pattern | split row "/" | enumerate | where {|s| $s.item | str contains "*"} | get 0.index
  }
}

def is-under [parent: string]: string -> bool {
  $in != $parent and ($in | str starts-with $"($parent)/")
}

def source-root []: nothing -> string {
  repo-root | path join "home"
}

def repo-root []: nothing -> string {
  $env.CURRENT_FILE | path dirname | path dirname
}
