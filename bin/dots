#!/usr/bin/env nu

const REPO = path self | path expand | path dirname --num-levels 2

# Manage dotfile symlinks declaratively
def main [] { help main }

# Compare the resolved link plan against what's on disk
def "main status" []: nothing -> table<state: string, target: string, source: string> {
  diff-plan (resolve-plan $REPO) (managed-links $REPO)
  | format-paths
  | sort-by state target
}

# Apply the resolved link plan
def "main apply" [
  --dry-run # Report the actions without touching anything
]: nothing -> oneof<table<action: string, target: string, source: string>, nothing> {
  let actions = diff-plan (resolve-plan $REPO) (managed-links $REPO)
  | where state != "ok"
  | rename --column {state: action}
  | update action {|r|
      match $r.action {
        missing => "create"
        wrong => "relink"
        stale => "remove"
        conflict => "conflict"
      }
    }

  if not $dry_run {
    for row in $actions { run-action $row }
  }
  if ($actions | is-not-empty) {
    $actions
    | format-paths
    | sort-by action target
  }
}

def resolve-plan [repo: path]: nothing -> table<source: string, target: string> {
  let plan = load-manifest $repo | each {|e| $e | expand-entry $repo } | flatten

  let nested = $plan | where {|r| $plan | any {|o| $r.target | is-under $o.target } }
  if ($nested | is-not-empty) {
    let inner = $nested | first
    let outer = $plan | where {|o| $inner.target | is-under $o.target } | first
    error make {msg: $"($inner.target | shorten) is inside ($outer.target | shorten), which is linked as well"}
  }

  $plan | sort-by target
}

def load-manifest [repo: path]: nothing -> table<target: string, source: string, exclude: list<string>> {
  let file = $repo | path join "dots.toml"
  if not ($file | path exists) {
    error make {msg: $"manifest not found: ($file)"}
  }
  let entries = open $file | get -o dotfiles
  if ($entries | is-empty) {
    error make {msg: $"($file): missing or empty [dotfiles] table"}
  }
  $entries | transpose target spec | each {|r|
    let spec = if ($r.spec | describe) == "string" { {source: $r.spec} } else { $r.spec }
    if not (($spec | describe | str starts-with "record") and "source" in $spec) {
      error make {msg: $"($file): ($r.target) must be a source path or a table with a source"}
    }
    {target: $r.target, source: $spec.source, exclude: ($spec | get -o exclude | default [])}
  }
}

def expand-entry [repo: path]: record -> table<source: string, target: string> {
  let entry = $in
  let target = $nu.home-dir | path join $entry.target

  if ($entry.source | str contains "*") {
    let matches = glob ($repo | path join $entry.source)
    if ($matches | is-empty) {
      error make {msg: $"source matches nothing: ($entry.source)"}
    }

    # Targets keep the path below the glob, so a nested match stays nested
    let root = $repo | path join ($entry.source | glob-root)
    $matches
    | each {|src| {source: $src, name: ($src | path relative-to $root)} }
    | where {|r| $r.name not-in $entry.exclude }
    | each {|r| {source: $r.source, target: ($target | path join $r.name)} }
  } else {
    let source = $repo | path join $entry.source
    if not ($source | path exists) {
      error make {msg: $"source not found: ($entry.source)"}
    }
    [
      {source: $source, target: $target}
    ]
  }
}

def managed-links [repo: path]: nothing -> table<link: string, points-to: string> {
  ^find $nu.home-dir -xdev -maxdepth 4 -type l -printf "%p\t%l\n"
  | lines
  | parse "{link}\t{raw}"
  | insert points-to {|l| $l.link | path dirname | path join $l.raw | path expand --no-symlink }
  | where {|l| ($l.points-to | is-at-or-under $repo) and not ($l.link | is-at-or-under $repo) }
  | select link points-to
}

def diff-plan [plan: table<source: string, target: string>, links: table<link: string, points-to: string>]: nothing -> table<state: string, target: string, source: string> {
  let claimed = $plan | get target

  # Stale links go first: one may be a directory the plan now links inside
  let stale = $links | where {|l| $l.link not-in $claimed }
  let removals = $stale | get link

  let removed = $stale | each {|l| {state: "stale", target: $l.link, source: $l.points-to} }
  let planned = $plan | each {|r| {state: (link-state $r.target $r.source $removals), target: $r.target, source: $r.source} }

  $removed | append $planned
}

def link-state [target: string, source: string, removals: list<string>]: nothing -> string {
  let kind: oneof<string, nothing> = $target | path type

  # A path under a pending removal counts as missing: removals are applied first
  if $kind == null or ($removals | any {|r| $target | is-under $r }) {
    "missing"
  } else if $kind != "symlink" {
    "conflict"
  } else if ($target | link-target) != $source {
    "wrong"
  } else {
    "ok"
  }
}

def link-target []: string -> string {
  let link = $in
  $link | path dirname | path join (^readlink $link | str trim) | path expand --no-symlink
}

def run-action [row: record] {
  match $row.action {
    create => { create-link $row.target $row.source }
    relink => {
      rm $row.target
      create-link $row.target $row.source
    }
    remove => { rm $row.target }
    conflict => { }
  }
}

def create-link [target: string, source: string] {
  mkdir ($target | path dirname)
  ^ln -s $source $target
}

def format-paths []: table -> table {
  update target {|r| $r.target | shorten } | update source {|r| $r.source | shorten }
}

def shorten []: string -> string {
  $in | str replace --regex $"^($nu.home-dir)/" "~/"
}

def glob-root []: string -> string {
  $in | split row "/" | take until {|p| $p | str contains "*" } | path join
}

def is-under [parent: string]: string -> bool {
  $in != $parent and ($in | str starts-with $"($parent)/")
}

def is-at-or-under [parent: string]: string -> bool {
  $in == $parent or ($in | is-under $parent)
}
