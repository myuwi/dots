+static cJSON *build_pointer_press_json(Monitor *m, Client *c,
+									   LayerSurface *l) {
+	cJSON *json = cJSON_CreateObject();
+
+	if (m)
+		cJSON_AddStringToObject(json, "monitor", m->wlr_output->name);
+	else
+		cJSON_AddNullToObject(json, "monitor");
+
+	if (c) {
+		cJSON *client = cJSON_CreateObject();
+		cJSON_AddNumberToObject(client, "id", c->id);
+		cJSON_AddStringToObject(client, "title", client_get_title(c));
+		cJSON_AddStringToObject(client, "appid", client_get_appid(c));
+		cJSON_AddItemToObject(json, "client", client);
+	} else {
+		cJSON_AddNullToObject(json, "client");
+	}
+
+	if (l) {
+		cJSON *layer = cJSON_CreateObject();
+		cJSON_AddStringToObject(
+			layer, "layer", layer_enum_str(l->layer_surface->current.layer));
+		cJSON_AddStringToObject(layer, "name",
+								l->layer_surface->namespace
+									? l->layer_surface->namespace
+									: "");
+		cJSON_AddItemToObject(json, "layer", layer);
+	} else {
+		cJSON_AddNullToObject(json, "layer");
+	}
+
+	return json;
+}
+
+void ipc_notify_pointer_press(Monitor *m, Client *c, LayerSurface *l) {
+	if (!ipc_pointer_press_watch_count)
+		return;
+
+	cJSON *json = build_pointer_press_json(m, c, l);
+
+	struct ipc_watch_client *wc, *tmp;
+	wl_list_for_each_safe(wc, tmp, &ipc_watch_clients, link) {
+		if (wc->type == IPC_WATCH_POINTER_PRESS)
+			ipc_notify_json_to_fd(wc->fd, json);
+	}
+	cJSON_Delete(json);
+}
