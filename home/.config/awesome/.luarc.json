{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "diagnostics": {
    "disable": [
      "lowercase-global",
      "redefined-local"
    ],
    "globals": [
      "awesome",
      "client",
      "mouse",
      "mousegrabber",
      "root",
      "screen",
      "tag"
    ]
  },
  "workspace": {
    "library": [
      "/usr/share/awesome/lib"
    ]
  }
}
